<UserControl x:Class="FloatTodo.Wpf.Controls.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="CompactAction" TargetType="Button">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeleteAction" TargetType="Button" BasedOn="{StaticResource CompactAction}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SaveAction" TargetType="Button" BasedOn="{StaticResource CompactAction}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBackgroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="EntryTemplate">
            <Border x:Name="Card" Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4" Padding="5,3" Margin="0,1" Focusable="True"
                    IsEnabled="{Binding IsAvailable}" MouseLeftButtonUp="OnRowClick" KeyDown="OnRowKeyDown"
                    AutomationProperties.Name="{Binding Text}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="Completion" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                              Click="OnCompletedClick" VerticalAlignment="Top" Margin="0,2,5,0"
                              MinHeight="0" MinWidth="0" Padding="0" RenderTransformOrigin="0.5,0.5"
                              AutomationProperties.Name="{Binding Text}" ToolTip="完成 / 恢复任务"/>
                    <TextBlock x:Name="EntryText" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                               MouseLeftButtonDown="OnTextMouseDown"/>
                    <TextBox x:Name="InlineEditor" Grid.Column="1" Visibility="Collapsed"
                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactInput}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="OnEditorKeyDown" IsVisibleChanged="OnEditorVisibilityChanged"
                             LostFocus="OnEditorLostFocus"
                             AutomationProperties.Name="行内编辑" ToolTip="Enter 保存 · Esc 撤销 · Shift+Enter 换行"/>
                    <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed"
                                VerticalAlignment="Top" Margin="4,0,0,0">
                        <Button Style="{StaticResource CompactAction}" Click="OnEditClick" ToolTip="{Binding EditHint}" AutomationProperties.Name="{Binding EditHint}">
                            <ic:SymbolIcon Symbol="Edit" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource CompactAction}" Click="OnConvertClick" ToolTip="{Binding ConvertHint}" AutomationProperties.Name="{Binding ConvertHint}">
                            <ic:SymbolIcon Symbol="ArrowSwap" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource DeleteAction}" Click="OnDeleteClick" ToolTip="{Binding DeleteHint}" AutomationProperties.Name="{Binding DeleteHint}">
                            <ic:SymbolIcon Symbol="Delete" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="EditActions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Top" Margin="4,0,0,0">
                        <Button Style="{StaticResource SaveAction}" Click="OnSaveEditClick" ToolTip="保存修改" AutomationProperties.Name="保存修改">
                            <ic:SymbolIcon Symbol="Checkmark" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource CompactAction}" Click="OnCancelEditClick" ToolTip="撤销修改" AutomationProperties.Name="撤销修改">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="EntryText" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="EntryText" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNote}" Value="True">
                    <Setter TargetName="Completion" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="EntryText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="InlineEditor" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Actions" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="EditActions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Completion" Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,4">
            <TextBox x:Name="QuickInput" Style="{StaticResource CompactInput}" PreviewKeyDown="OnInputKeyDown"
                     AutomationProperties.Name="任务内容" ToolTip="Enter 添加待办 · Esc 清空"/>
            <TextBlock Text="+ 添加待办…" Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickInput}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </Grid>
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12"
                   Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Assertive"/>
        <Button x:Name="RetryButton" Content="重新加载" Visibility="Collapsed" Click="OnRetryClick" HorizontalAlignment="Left"/>
        <TextBlock x:Name="EmptyText" Visibility="Collapsed" Text="暂无待办" Margin="0,2,0,4" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ItemsControl x:Name="TaskList" ItemTemplate="{StaticResource EntryTemplate}"/>
        <Separator Margin="0,6,0,6" Background="{DynamicResource CardBorderBrush}" Opacity="0.4"/>
        <TextBlock Text="Scratch" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Grid Margin="0,0,0,4">
            <TextBox x:Name="NoteInput" Style="{StaticResource CompactInput}" AcceptsReturn="True" TextWrapping="Wrap"
                     MaxHeight="120" VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnInputKeyDown"
                     AutomationProperties.Name="笔记内容" ToolTip="Enter 添加笔记 · Shift+Enter 换行 · Esc 清空"/>
            <TextBlock Text="+ 添加笔记…" Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NoteInput}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </Grid>
        <TextBlock x:Name="EmptyNotesText" Visibility="Collapsed" Text="暂无笔记" Margin="0,2,0,4" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ItemsControl x:Name="NoteList" ItemTemplate="{StaticResource EntryTemplate}"/>
    </StackPanel>
</UserControl>

