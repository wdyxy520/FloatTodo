<UserControl x:Class="FloatTodo.Wpf.Controls.EdgeHandle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="6"
             Background="Transparent"
             Cursor="Hand">
    <Grid>
        <!-- Background subtle border strip -->
        <Border Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.9" />
        <!-- Center Accent Handle Indicator -->
        <Border Width="4" Height="56" 
                CornerRadius="2" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Background="{DynamicResource AccentBrush}"
                Opacity="0.9" />
    </Grid>
</UserControl>
