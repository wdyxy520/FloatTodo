<Page
    x:Class="FloatTodo.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="WallpaperPreviewBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3B82F6" Offset="0.0" />
                        <GradientStop Color="#8B5CF6" Offset="0.45" />
                        <GradientStop Color="#EC4899" Offset="0.8" />
                        <GradientStop Color="#F59E0B" Offset="1.0" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="WallpaperPreviewBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0.0" />
                        <GradientStop Color="#1E3A8A" Offset="0.35" />
                        <GradientStop Color="#6B21A8" Offset="0.75" />
                        <GradientStop Color="#B45309" Offset="1.0" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer
        x:Name="SettingsScroll"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="12,4,12,16">
        <Grid x:Name="ContentGrid" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="Row0" Height="Auto" />
                <RowDefinition x:Name="Row1" Height="Auto" />
                <RowDefinition x:Name="Row2" Height="Auto" />
                <RowDefinition x:Name="Row3" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 外观与材质 -->
            <StackPanel x:Name="CardAppearance" Spacing="8" VerticalAlignment="Top" Grid.Row="0" Grid.Column="0">
                <TextBlock
                    x:Uid="AppearanceHeader"
                    Text="外观与材质"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border
                    x:Name="AppearanceBorder"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                    <StackPanel Spacing="12">
                        <!-- 外观主题设置行 -->
                        <Grid x:Name="ThemeRow" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ThemeCol0" Width="*" />
                                <ColumnDefinition x:Name="ThemeCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="ThemeTitle"
                                x:Uid="ThemeTitle"
                                Text="外观主题"
                                VerticalAlignment="Center"
                                FontSize="14" />
                            <ComboBox
                                x:Name="ThemeComboBox"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="外观主题">
                                <ComboBoxItem x:Uid="ThemeSystem" Content="跟随系统" />
                                <ComboBoxItem x:Uid="ThemeLight" Content="浅色" />
                                <ComboBoxItem x:Uid="ThemeDark" Content="深色" />
                            </ComboBox>
                        </Grid>

                        <!-- 背景材质设置行 -->
                        <Grid x:Name="MaterialRow" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MaterialCol0" Width="*" />
                                <ColumnDefinition x:Name="MaterialCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="MaterialTitle"
                                x:Uid="MaterialTitle"
                                Text="背景材质"
                                VerticalAlignment="Center"
                                FontSize="14" />
                            <ComboBox
                                x:Name="MaterialComboBox"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="背景材质">
                                <ComboBoxItem Content="Mica" />
                                <ComboBoxItem Content="Mica Alt" />
                                <ComboBoxItem x:Uid="MaterialAcrylic" Content="Acrylic 毛玻璃" />
                                <ComboBoxItem x:Uid="MaterialSolid" Content="纯色" />
                            </ComboBox>
                        </Grid>

                        <TextBlock
                            x:Uid="MaterialHint"
                            Text="Mica 提取壁纸色彩；Acrylic 模糊窗口后方内容；若系统未启用透明效果则回退为纯色。"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 桌面预览 -->
            <StackPanel x:Name="CardPreview" Spacing="8" VerticalAlignment="Top" Grid.Row="1" Grid.Column="0">
                <TextBlock
                    x:Uid="PreviewHeader"
                    Text="桌面预览"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border
                    x:Name="PreviewBorder"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                    <StackPanel Spacing="10">
                        <!-- 桌面预览不透明度设置行 -->
                        <Grid x:Name="OpacityRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="OpacityCol0" Width="*" />
                                <ColumnDefinition x:Name="OpacityCol1" Width="Auto" />
                                <ColumnDefinition x:Name="OpacityCol2" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Name="OpacityTitle"
                                x:Uid="OpacityTitle"
                                Text="桌面预览不透明度"
                                VerticalAlignment="Center"
                                FontSize="14" />
                            <Slider
                                x:Name="PreviewOpacitySlider"
                                Minimum="40"
                                Maximum="100"
                                StepFrequency="1"
                                TickFrequency="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="桌面预览不透明度" />
                            <TextBlock
                                x:Name="OpacityPercentText"
                                Text="75%"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                FontSize="14"
                                HorizontalAlignment="Right" />
                        </Grid>

                        <!-- 实时便签透光效果预览框 -->
                        <TextBlock
                            x:Uid="PreviewEffectHint"
                            Text="实时透光预览效果："
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!-- 模拟桌面壁纸环境容器 -->
                        <Border
                            x:Name="WallpaperContainer"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            Background="{ThemeResource WallpaperPreviewBrush}"
                            Padding="8,8">
                            <Grid>
                                <!-- 底层桌面壁纸与衬底元素（直观体现半透明时的穿透效果） -->
                                <Grid IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0" Opacity="0.8">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="11" Foreground="White" />
                                        <TextBlock x:Uid="WallpaperBadge" Text="模拟桌面壁纸" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <!-- 桌面图标与文字（半透明时会从便签卡片下方穿透可见） -->
                                    <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,12,0,0" Opacity="0.6">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="White"/>
                                            <TextBlock x:Uid="DesktopIcon1" Text="项目文档" FontSize="10" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="White"/>
                                            <TextBlock x:Uid="DesktopIcon2" Text="工作日志" FontSize="10" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE777;" FontSize="16" Foreground="White"/>
                                            <TextBlock x:Uid="DesktopIcon3" Text="图片壁纸" FontSize="10" Foreground="White"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 前景便签卡片：其 Opacity 直接受滑块控制 -->
                                <Border
                                    x:Name="MiniPreviewCard"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,18,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="PreviewTitleText"
                                            x:Uid="PreviewTitleText"
                                            Text="今日便签（桌面预览）"
                                            FontSize="13"
                                            FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="PreviewCheckIcon"
                                                Text="✓"
                                                FontSize="12"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock
                                                x:Name="PreviewCheckText"
                                                x:Uid="PreviewCheckText"
                                                Grid.Column="1"
                                                Text="拖动滑块实时观察透光效果"
                                                FontSize="12" />
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="PreviewBulletText"
                                                Text="○"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                x:Name="PreviewBulletDesc"
                                                x:Uid="PreviewBulletDesc"
                                                Grid.Column="1"
                                                Text="壁纸色彩穿透，文字清晰可辨"
                                                FontSize="12" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 试看实际桌面效果行 -->
                        <Grid x:Name="PeekRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PeekCol0" Width="*" />
                                <ColumnDefinition x:Name="PeekCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button
                                x:Name="PeekPreviewButton"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE890;" FontSize="14" />
                                    <TextBlock x:Uid="PeekButtonLabel" Text="试看实际桌面效果" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                x:Name="PeekTipText"
                                x:Uid="PeekTipText"
                                Text="点击立即在桌面壁纸上试看，单击任意处可返回设置。"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 窗口与行为 -->
            <StackPanel x:Name="CardBehavior" Spacing="8" VerticalAlignment="Top" Grid.Row="2" Grid.Column="0">
                <TextBlock
                    x:Uid="BehaviorHeader"
                    Text="窗口与行为"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border
                    x:Name="BehaviorBorder"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                    <StackPanel Spacing="10">
                        <!-- 保持置顶行 -->
                        <Grid x:Name="TopmostRow" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="TopmostCol0" Width="*" />
                                <ColumnDefinition x:Name="TopmostCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="TopmostTitle"
                                x:Uid="TopmostTitle"
                                Text="保持置顶"
                                VerticalAlignment="Center"
                                FontSize="14" />
                            <ToggleSwitch
                                x:Name="TopmostSwitch"
                                x:Uid="TopmostSwitch"
                                OnContent="已开启"
                                OffContent="已关闭"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="保持置顶" />
                        </Grid>

                        <!-- 贴边后自动收起行 -->
                        <Grid x:Name="AutoHideRow" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AutoHideCol0" Width="*" />
                                <ColumnDefinition x:Name="AutoHideCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="AutoHideTitle"
                                x:Uid="AutoHideTitle"
                                Text="贴边后自动收起"
                                VerticalAlignment="Center"
                                FontSize="14" />
                            <ToggleSwitch
                                x:Name="AutoHideSwitch"
                                x:Uid="AutoHideSwitch"
                                OnContent="已开启"
                                OffContent="已关闭"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="贴边后自动收起" />
                        </Grid>

                        <!-- 开机启动行 -->
                        <Grid x:Name="StartupRow" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="StartupCol0" Width="*" />
                                <ColumnDefinition x:Name="StartupCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="StartupTitle"
                                x:Uid="StartupTitle"
                                Text="开机启动"
                                VerticalAlignment="Center"
                                FontSize="14" />
                            <ToggleSwitch
                                x:Name="StartupSwitch"
                                x:Uid="StartupSwitch"
                                OnContent="已开启"
                                OffContent="已关闭"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="开机启动" />
                        </Grid>

                        <!-- 自动检查更新行 -->
                        <Grid x:Name="AutoCheckUpdateRow" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AutoCheckUpdateCol0" Width="*" />
                                <ColumnDefinition x:Name="AutoCheckUpdateCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="AutoCheckUpdateTitle"
                                x:Uid="AutoCheckUpdateTitle"
                                Text="自动检查更新"
                                VerticalAlignment="Center"
                                FontSize="14" />
                            <ToggleSwitch
                                x:Name="AutoCheckUpdateSwitch"
                                x:Uid="AutoCheckUpdateSwitch"
                                OnContent="已开启"
                                OffContent="已关闭"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="自动检查更新" />
                        </Grid>

                        <!-- 语言设置行 -->
                        <Grid x:Name="LanguageRow" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LanguageCol0" Width="*" />
                                <ColumnDefinition x:Name="LanguageCol1" Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="LanguageLabelPanel" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="LanguageTitle"
                                    x:Uid="LanguageTitle"
                                    Text="语言"
                                    FontSize="14" />
                                <TextBlock
                                    x:Name="LanguageHint"
                                    Text="重启应用后生效"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox
                                x:Name="LanguageComboBox"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="语言">
                                <ComboBoxItem Tag="" Content="跟随系统 (Follow System)" />
                                <ComboBoxItem Tag="zh-CN" Content="简体中文" />
                                <ComboBoxItem Tag="en-US" Content="English" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 底部轻量版本与更新信息 -->
            <StackPanel
                x:Name="FooterSection"
                Spacing="6"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Grid.Row="3"
                Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock
                        x:Name="VersionText"
                        Text="FloatTodo"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="•"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center" />
                    <HyperlinkButton
                        x:Name="CheckUpdateButton"
                        x:Uid="CheckUpdateButton"
                        Content="检查更新"
                        FontSize="11"
                        Padding="2,0"
                        VerticalAlignment="Center" />
                    <ProgressRing
                        x:Name="UpdateProgressRing"
                        IsActive="False"
                        Visibility="Collapsed"
                        Width="12"
                        Height="12"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- 更新状态提示条 -->
                <InfoBar
                    x:Name="UpdateInfoBar"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Informational"
                    FontSize="12"
                    MaxWidth="480">
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <Button
                                x:Name="DownloadMirrorButton"
                                x:Uid="DownloadMirrorButton"
                                Content="国内加速下载"
                                Style="{StaticResource AccentButtonStyle}"
                                FontSize="11"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="DownloadOfficialButton"
                                x:Uid="DownloadOfficialButton"
                                Content="官方下载"
                                FontSize="11"
                                Visibility="Collapsed" />
                            <HyperlinkButton
                                x:Name="ViewReleaseButton"
                                x:Uid="ViewReleaseButton"
                                Content="更新日志"
                                FontSize="11"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
