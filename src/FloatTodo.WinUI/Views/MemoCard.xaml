<UserControl
    x:Class="FloatTodo.WinUI.Views.MemoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FloatTodo.ViewModels">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBorderBrushFocused" Color="Transparent" />
    </UserControl.Resources>
    <Grid
        x:Name="Card"
        PreviewKeyDown="OnEditorPreviewKeyDown">
        <Grid.ContextFlyout>
            <MenuFlyout Opened="OnCardFlyoutOpened">
                <MenuFlyoutItem Command="{x:Bind ViewModel.ConvertCommand, Mode=OneWay}" Text="{x:Bind ViewModel.ConvertHint, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE73A;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Command="{x:Bind ViewModel.AddTitleCommand, Mode=OneWay}" Text="{x:Bind ViewModel.TitleToggleLabel, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="DeleteMemoMenuItem" Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}" Text="删除记事">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Border
            x:Name="CardSurface"
            Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False" />
        <Grid Margin="13,9">
            <StackPanel
                x:Name="Editor"
                Background="Transparent"
                IsTabStop="True"
                KeyDown="OnPreviewKeyDown">
                <TextBox
                    x:Name="TitleEditor"
                    x:Uid="TitleEditor"
                    AcceptsReturn="False"
                    FontWeight="SemiBold"
                    PlaceholderText="标题"
                    Style="{StaticResource InlineEditor}"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.ShowTitle, Mode=OneWay, Converter={StaticResource Visible}}"
                    IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                    IsTabStop="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
                    IsHitTestVisible="{x:Bind ViewModel.IsEditing, Mode=OneWay}" />
                <TextBox
                    x:Name="BodyEditor"
                    x:Uid="BodyEditor"
                    PlaceholderText="记一条…"
                    Style="{StaticResource InlineEditor}"
                    Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.IsChecklist, Mode=OneWay, Converter={StaticResource Visible}, ConverterParameter=Invert}"
                    IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                    IsTabStop="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
                    IsHitTestVisible="{x:Bind ViewModel.IsEditing, Mode=OneWay}" />
                <ListView
                    x:Name="EditableItems"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    CanReorderItems="{x:Bind ViewModel.IsReordering, Mode=OneWay}"
                    CanDragItems="{x:Bind ViewModel.IsReordering, Mode=OneWay}"
                    AllowDrop="{x:Bind ViewModel.IsReordering, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    Padding="0"
                    DragItemsStarting="EditableItems_DragItemsStarting"
                    DragItemsCompleted="EditableItems_DragItemsCompleted"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    Visibility="{x:Bind ViewModel.IsChecklist, Mode=OneWay, Converter={StaticResource Visible}}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="UseSystemFocusVisuals" Value="False" />
                            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                            <Grid
                                MinHeight="32"
                                Visibility="{x:Bind IsRowVisible, Mode=OneWay, Converter={StaticResource Visible}}"
                                Loaded="RowLoaded"
                                Unloaded="RowUnloaded">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 待办与已完成之间的清晰横线分割：贴于顶部，不改变行高尺寸，防止重排时抖动 -->
                                <Border
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Stretch"
                                    Margin="4,0,4,0"
                                    Visibility="{x:Bind ShowsTopDivider, Mode=OneWay, Converter={StaticResource Visible}}" />
                                    <!-- 排序手柄 handle：数据驱动仅在开启排序模式时显示，支持列表原生拖拽与点击快捷菜单 -->
                                    <Border
                                        x:Name="DragHandle"
                                        Width="24"
                                        Height="28"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,2,0"
                                        Visibility="{x:Bind IsReordering, Mode=OneWay, Converter={StaticResource Visible}}"
                                        Tapped="OnHandleTapped"
                                        PointerEntered="OnDragHandlePointerEntered"
                                        PointerExited="OnDragHandlePointerExited"
                                        ToolTipService.ToolTip="拖拽排序或点击选项 (Alt+上下键)">
                                        <Border.ContextFlyout>
                                             <MenuFlyout Opened="OnCardFlyoutOpened">
                                                <MenuFlyoutItem x:Uid="MoveUpMenuItem" Text="上移一行" Click="MoveUp_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="MoveDownMenuItem" Text="下移一行" Click="MoveDown_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="DeleteItemMenuItem" Command="{x:Bind RemoveCommand}" Text="删除此项">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                             </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <PathIcon
                                            Data="M 3,1 A 1.5,1.5 0 1,1 3,4 A 1.5,1.5 0 1,1 3,1 M 3,7 A 1.5,1.5 0 1,1 3,10 A 1.5,1.5 0 1,1 3,7 M 3,13 A 1.5,1.5 0 1,1 3,16 A 1.5,1.5 0 1,1 3,13"
                                            Width="8"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <CheckBox
                                        x:Name="ItemCheckBox"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        MinHeight="28"
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="{x:Bind Text, Mode=OneWay}"
                                        IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                        Opacity="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource CompletedOpacity}}"
                                        Tapped="CheckboxTapped" />
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Background="Transparent">
                                        <TextBox
                                            x:Name="ItemBox"
                                            AcceptsReturn="False"
                                            PreviewKeyDown="ItemPreviewKeyDown"
                                            Loaded="ItemLoaded"
                                            PlaceholderText="添加一项…"
                                            Style="{StaticResource InlineEditor}"
                                            Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="{x:Bind IsReadOnly, Mode=OneWay}"
                                            IsTabStop="{x:Bind IsEditing, Mode=OneWay}"
                                            IsHitTestVisible="{x:Bind IsEditing, Mode=OneWay}"
                                            Opacity="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource CompletedOpacity}}"
                                            Unloaded="ItemUnloaded">
                                            <TextBox.ContextFlyout>
                                                <MenuFlyout Opened="OnCardFlyoutOpened">
                                                    <MenuFlyoutItem x:Uid="DeleteItemMenuItem" Command="{x:Bind RemoveCommand}" Text="删除此项" />
                                                </MenuFlyout>
                                            </TextBox.ContextFlyout>
                                        </TextBox>
                                        <!-- 删除线：位于 TextBox 文字中心，穿透交互直接聚焦 TextBox，仅在完成时显示 -->
                                        <Border
                                            Height="1"
                                            Background="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,4,0"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource Visible}}" />
                                    </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EditorActions">
                    <Button
                        x:Name="AddItemButton"
                        x:Uid="AddItemButton"
                        Margin="20,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.AddItemCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsChecklist, Mode=OneWay, Converter={StaticResource Visible}}"
                        Content="＋ 添加一项" />
                    <Grid Padding="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 常用功能平铺展开为图标按钮 -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                Width="30"
                                Height="30"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.AddTitleCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.TitleToggleLabel, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.TitleToggleLabel, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8D2;" FontSize="13" />
                            </Button>
                            <Button
                                Width="30"
                                Height="30"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.ConvertCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ConvertHint, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ConvertHint, Mode=OneWay}">
                                <FontIcon Glyph="&#xE73A;" FontSize="13" />
                            </Button>
                            <ToggleButton
                                x:Name="ReorderButton"
                                Width="30"
                                Height="30"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="0"
                                IsChecked="{x:Bind ViewModel.IsReordering, Mode=TwoWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ReorderToggleLabel, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ReorderToggleLabel, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsChecklist, Mode=OneWay, Converter={StaticResource Visible}}">
                                <ToggleButton.Resources>
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                </ToggleButton.Resources>
                                <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                            </ToggleButton>
                            <Button
                                x:Name="DeleteCardButton"
                                Width="30"
                                Height="30"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            </Button>
                        </StackPanel>
                        <!-- 完成按钮 -->
                        <Button
                            x:Name="DoneButton"
                            x:Uid="DoneButton"
                            Grid.Column="1"
                            AutomationProperties.AcceleratorKey="Ctrl+Enter"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.FinishEditCommand, Mode=OneWay}"
                            Content="完成" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
