<UserControl x:Class="FloatTodo.WinUI.Views.CompactMemoCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Padding="10,7" CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
  <StackPanel Spacing="3">
   <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding ShowTitle, Converter={StaticResource Visible}}"/>
   <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" Visibility="{Binding IsChecklist, Converter={StaticResource Visible}, ConverterParameter=Invert}"/>
    <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsChecklist, Converter={StaticResource Visible}}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Visibility="{Binding HasText, Converter={StaticResource Visible}}">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
       </Grid.RowDefinitions>
       <Border Height="1" Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.45" Margin="0,6,0,6" Visibility="{Binding ShowsTopDivider, Converter={StaticResource Visible}}"/>
       <Grid Grid.Row="1" ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="○" Visibility="{Binding IsCompleted, Converter={StaticResource Visible}, ConverterParameter=Invert}"/>
        <TextBlock Text="✓" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{Binding IsCompleted, Converter={StaticResource Visible}}"/>
        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" Visibility="{Binding IsCompleted, Converter={StaticResource Visible}, ConverterParameter=Invert}"/>
        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" TextDecorations="Strikethrough" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding IsCompleted, Converter={StaticResource Visible}}"/>
       </Grid>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
 </Border>
</UserControl>
