<UserControl
    x:Class="FloatTodo.WinUI.Views.CompactMemoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FloatTodo.ViewModels">
    <Border Padding="10,7" CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="3">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ShowTitle, Mode=OneWay, Converter={StaticResource Visible}}"/>
            <TextBlock Text="{x:Bind ViewModel.Text, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsChecklist, Mode=OneWay, Converter={StaticResource Visible}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsChecklist, Mode=OneWay, Converter={StaticResource Visible}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                        <Grid Visibility="{x:Bind HasText, Mode=OneWay, Converter={StaticResource Visible}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Height="1" Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.45" Margin="0,6,0,6" Visibility="{x:Bind ShowsTopDivider, Mode=OneWay, Converter={StaticResource Visible}}"/>
                            <Grid Grid.Row="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="○" Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource Visible}, ConverterParameter=Invert}"/>
                                <TextBlock Text="✓" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource Visible}}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Text, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource Visible}, ConverterParameter=Invert}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Text, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" TextDecorations="Strikethrough" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource Visible}}"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
