<UserControl
    x:Class="FloatTodo.WinUI.Views.DesktopPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FloatTodo.ViewModels"
    xmlns:local="using:FloatTodo.WinUI.Views"
    IsHitTestVisible="False">
    <Grid Padding="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.SavedMemos, Mode=OneWay}" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MemoViewModel">
                    <local:CompactMemoCard Margin="0,0,0,6"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
