<UserControl x:Class="FloatTodo.WinUI.Views.DesktopPreviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FloatTodo.WinUI.Views" IsHitTestVisible="False">
 <Grid Padding="10,0,10,10">
  <Grid.RowDefinitions>
   <RowDefinition Height="36"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <ItemsControl Grid.Row="1" ItemsSource="{Binding SavedMemos}" VerticalAlignment="Top">
   <ItemsControl.ItemTemplate><DataTemplate><local:CompactMemoCard Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </Grid>
</UserControl>
